{
  "name": "Square Catalog DB Daily Prune",
  "description": "Every evening at 8:45pm Edmonton: calls the RxDeliver squarePruneCatalogDb function via REST to prune SquareCatalogItems DB to mirror the live Square catalog, keeping the DB clean just before the 8:50pm Square sync and 9pm COD briefing. Silent on success, alerts the owner only on failure.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "45 20 * * *",
      "one_time_date": null,
      "timezone": "America/Edmonton",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_and_report": {
          "call": "invoke_superagent_step",
          "then": "end",
          "with": {
            "message": "It is 8:45pm \u2014 the daily Square catalog DB prune is running now. Follow these steps exactly:\n\n1. Run this bash command (it triggers the RxDeliver prune function, which removes SquareCatalogItems records no longer present in the live Square catalog):\ncurl -s --max-time 240 -X POST 'https://base44.app/api/apps/68570f3cd01bfa2d2408a9d6/functions/squarePruneCatalogDb' -H \"Authorization: Bearer $BASE44_SERVICE_TOKEN\" -H 'Content-Type: application/json' -d '{}'\n\n2. Check the JSON result. If success is true, do NOT message the owner \u2014 a clean prune needs no attention. Log nothing further and stop.\n3. If it failed (success false, HTTP error, or an error field), send the owner ONE short WhatsApp message via broadcast_message describing what failed, then stop."
          },
          "x-base44": {
            "description": "Prune SquareCatalogItems DB to mirror live catalog",
            "title": "Square catalog DB prune"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "square_catalog_db_daily_prune",
      "namespace": "base44",
      "version": "1.0.2"
    }
  }
}