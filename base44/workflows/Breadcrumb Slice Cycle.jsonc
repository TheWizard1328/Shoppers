{
  "name": "Breadcrumb Slice Cycle",
  "description": "Every 5 minutes, runs the full home-anchored breadcrumb slicing server-side for every driver-date with a master trail (today + yesterday). Replaces the per-stop-finish slice invoke on driver devices \u2014 the phone now only force-flushes its master trail.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Edmonton",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "slice_cycle": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "mode": "cycle"
            },
            "function_name": "consolidateBreadcrumbSegment"
          },
          "x-base44": {
            "description": "Full walk per active route",
            "title": "Slice breadcrumb trails"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "breadcrumb_slice_cycle",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}