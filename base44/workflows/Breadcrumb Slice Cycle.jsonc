{
  "name": "Breadcrumb Slice Cycle",
  "description": "Every 5 minutes, asks the slicer for routes that just had a stop finish. The slicer itself decides scope: it only slices driver+date pairs where a delivery flipped to completed within the last 12 minutes, and does nothing when no stop finished. Sealed (saved_to_route) legs stay protected. The old behavior (re-slice every driver-date, 24/7) is gone.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Edmonton",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "slice_cycle": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "mode": "cycle"
            },
            "function_name": "consolidateBreadcrumbSegment"
          },
          "x-base44": {
            "description": "Only routes with a recent stop finish",
            "title": "Slice breadcrumb trails"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "breadcrumb_slice_cycle",
      "namespace": "base44",
      "version": "1.1"
    }
  }
}