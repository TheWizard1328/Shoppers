{
  "name": "Process Breadcrumb Leg on Delivery Complete",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\" or .trigger.data.status == \"failed\" or .trigger.data.status == \"cancelled\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Delivery"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_breadcrumb_leg_on_delivery_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processBreadcrumbLeg",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}