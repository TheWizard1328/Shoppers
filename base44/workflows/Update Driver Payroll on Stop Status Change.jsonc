{
  "name": "Update Driver Payroll on Stop Status Change",
  "description": "Recalculates the driver's payroll record whenever a stop enters or leaves a finished state (completed, failed, cancelled) or reverts to an active state (pending, in_transit, en_route).",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\" or .trigger.data.status == \"failed\" or .trigger.data.status == \"cancelled\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Delivery"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "update_driver_payroll_on_stop_status_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "calculateDriverPayroll",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}