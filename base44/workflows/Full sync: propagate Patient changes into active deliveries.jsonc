{
  "name": "Full sync: propagate Patient changes into active deliveries",
  "description": "When a Patient is updated, ensure all of today\u2019s active deliveries for its driver(s) are refreshed (fallback manual trigger by driver/date).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Patient"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "full_sync_propagate_patient_changes_into_active_deliveries",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncRoutePatients",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}