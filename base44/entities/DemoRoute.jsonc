{
  "name": "DemoRoute",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "delivery_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "created_by_app_user_id": {
      "type": "string"
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_time_start": {
      "type": "string"
    },
    "delivery_time_end": {
      "type": "string"
    },
    "delivery_time_eta": {
      "type": "string"
    },
    "arrival_time": {
      "type": "string"
    },
    "actual_delivery_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_transit",
        "en_route",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "prescription_number": {
      "type": "string"
    },
    "delivery_notes": {
      "type": "string"
    },
    "delivery_instructions": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "stop_order": {
      "type": "number"
    },
    "stop_id": {
      "type": "string"
    },
    "puid": {
      "type": "string"
    },
    "extra_time": {
      "type": "number",
      "default": 5
    },
    "travel_dist": {
      "type": "number"
    },
    "paid_km_override": {
      "type": "number"
    },
    "cod_total_amount_required": {
      "type": "number"
    },
    "cod_payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Cash",
              "Debit",
              "Credit",
              "Check"
            ]
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "amount"
        ]
      }
    },
    "cod_payment_type": {
      "type": "string",
      "enum": [
        "No Payment",
        "Cash",
        "Debit",
        "Credit",
        "Check"
      ],
      "default": "No Payment"
    },
    "cod_amount": {
      "type": "string"
    },
    "signature_needed": {
      "type": "boolean",
      "default": false
    },
    "signature_image_url": {
      "type": "string"
    },
    "proof_photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "barcode_values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipt_barcode_values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fridge_item": {
      "type": "boolean",
      "default": false
    },
    "oversized": {
      "type": "boolean",
      "default": false
    },
    "after_hours_pickup": {
      "type": "boolean",
      "default": false
    },
    "no_charge": {
      "type": "boolean",
      "default": false
    },
    "first_delivery": {
      "type": "boolean",
      "default": false
    },
    "isNextDelivery": {
      "type": "boolean",
      "default": false
    },
    "ampm_deliveries": {
      "type": "string",
      "enum": [
        "AM",
        "PM"
      ]
    },
    "delivery_route_breadcrumbs": {
      "type": "string"
    },
    "finished_leg_encoded_polyline": {
      "type": "string"
    },
    "PolylineUpdated": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": true,
      "description": "Flag to indicate if this is demo data"
    },
    "latitude": {
      "type": "number",
      "description": "Patient delivery latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Patient delivery longitude"
    },
    "is_cycling_marker": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a cycling route marker"
    },
    "cycling_latitude": {
      "type": "number",
      "description": "Cycling marker latitude"
    },
    "cycling_longitude": {
      "type": "number",
      "description": "Cycling marker longitude"
    },
    "transport_mode": {
      "type": "string",
      "enum": [
        "driving",
        "cycling"
      ],
      "default": "driving"
    },
    "_interstore_source_id": {
      "type": "string",
      "description": "InterStore source store ID (ISP)"
    },
    "_interstore_dest_id": {
      "type": "string",
      "description": "InterStore destination store ID (ISD)"
    },
    "_interstore_source_name": {
      "type": "string",
      "description": "InterStore source store name"
    },
    "_interstore_dest_name": {
      "type": "string",
      "description": "InterStore destination store name"
    },
    "estimated_distance_km": {
      "type": "number",
      "description": "Estimated route distance in km"
    },
    "estimated_duration_minutes": {
      "type": "number",
      "description": "Estimated route duration in minutes"
    },
    "first_leg_origin_lat": {
      "type": "number",
      "description": "Origin latitude for first leg (home or previous stop)"
    },
    "first_leg_origin_lng": {
      "type": "number",
      "description": "Origin longitude for first leg"
    },
    "driver_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "driver_acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "encoded_polyline": {
      "type": "string",
      "description": "Encoded polyline for the route leg"
    },
    "polyline_saved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "delivery_date"
  ]
}