    },
    "parts_count": {
      "type": "number",
      "description": "Number of payload shards present (p1..pN). Absent/0 means a legacy record that stores the whole summary in `payload`."
    },
    "ping": {
      "type": "boolean",
      "description": "TRANSPORT PING (owner report Nov 3 2026: the payload record was oversize for the realtime broadcast and got stubbed in transport). True means this record carries NO payload \u2014 it exists only to broadcast a tiny create/update so every device pulls the real record by snapshot_id. Readers always skip ping rows."
    },
    "snapshot_id": {
      "type": "string",
      "description": "For a ping record: the id of the payload record it announces (the silent, service-role write made by squareBalancesCompute publish_payload)"
    },
    "anchor": {
      "type": "boolean",
      "description": "ANCHOR RECORD marker (Nov 4 2026). The anchor is a tiny record that carries the metadata and NO payload text; the summary JSON lives in separate PART records (see part_of). Anchors and pings are the only rows whose realtime events may trigger a client pull."
    },
    "part_of": {
      "type": "string",
      "description": "PART RECORD link (Nov 4 2026): the id of the anchor record this payload slice belongs to. Part rows carry ~8 KB of summary JSON each so NO record ever exceeds the realtime transport limit (a 30 KB shard-in-one-record payload was stubbed on every broadcast and every device answered with a full re-download \u2014 the Nov 4 rate-limit storm)."
    },
    "part_index": {
      "type": "number",
      "description": "PART RECORD ordering (Nov 4 2026): 0-based slice index; readers sort ascending and concatenate part_text to rebuild the summary JSON."
    },
    "part_text": {
      "type": "string",
      "description": "PART RECORD payload slice (Nov 4 2026): ~8000 characters of the summary JSON. Concatenate part_text over ascending part_index, then JSON.parse."
    }
  },
  "required": [
    "version"
  ],
  "rls": {}
}