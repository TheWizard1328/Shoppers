{
  "name": "PatientPortalPresence",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to the patient whose portal session this presence record tracks"
    },
    "patient_name": {
      "type": "string",
      "description": "Denormalized display name of the patient (for quick display without a join)"
    },
    "driver_id": {
      "type": "string",
      "description": "ID of the driver assigned to the delivery being watched / driven to"
    },
    "driver_name": {
      "type": "string",
      "description": "Denormalized display name of the assigned driver"
    },
    "store_id": {
      "type": "string",
      "description": "ID of the store associated with the watched delivery"
    },
    "store_name": {
      "type": "string",
      "description": "Denormalized display name of the associated store"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "The delivery date this presence record is scoped to (YYYY-MM-DD)"
    },
    "last_ping_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent presence ping from the patient portal watcher"
    }
  },
  "required": [
    "patient_id",
    "delivery_date",
    "last_ping_at"
  ],
  "rls": {}
}