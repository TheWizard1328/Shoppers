{
  "name": "CodBadgeChangeLog",
  "type": "object",
  "properties": {
    "changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the badge/tender change was made"
    },
    "action": {
      "type": "string",
      "description": "Record category: discrepancy (payment type mismatch vs Square), spend_toggle, tender_convert, refund_mark, auto_card_detected"
    },
    "detail": {
      "type": "string",
      "description": "Human-readable change, e.g. 'Card Spend -> Not Tapped', 'Cash -> Debit (combined swipe, 3 items)'"
    },
    "delivery_id": {
      "type": "string",
      "description": "Primary delivery the change was made on"
    },
    "delivery_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All deliveries included in the change (all items for a combined swipe)"
    },
    "patient_names": {
      "type": "string",
      "description": "Patient name(s), comma-joined for combined swipes"
    },
    "store_name": {
      "type": "string",
      "description": "Store name(s), comma-joined when a change spans stores"
    },
    "amount_cents": {
      "type": "integer",
      "description": "Total amount affected, in cents"
    },
    "fee_c": {
      "type": "integer",
      "description": "Square fee on the swipe total, cents (Debit/Credit conversions only)"
    },
    "loan_c": {
      "type": "integer",
      "description": "Loan share on the swipe total, cents (Debit/Credit conversions only)"
    },
    "folder_c": {
      "type": "integer",
      "description": "Folder share on the swipe total, cents (Debit/Credit conversions only)"
    },
    "settled_c": {
      "type": "integer",
      "description": "Amount that settled back onto the card (amount - fee - loan - folder), cents"
    },
    "changed_by": {
      "type": "string",
      "description": "Base44 auth id of the user who made the change"
    },
    "changed_by_name": {
      "type": "string",
      "description": "Display name/email of the user who made the change ('Square sync (auto)' for backend-detected discrepancies)"
    },
    "discrepancy_kind": {
      "type": "string",
      "description": "Discrepancy category: cash_swiped (recorded Cash, Square shows a card swipe), type_mismatch (Debit vs Credit), mixed_tenders, missing_payment (recorded card, nothing on Square)"
    },
    "recorded_type": {
      "type": "string",
      "description": "Collection type recorded in the app: cash / debit / credit / mixed"
    },
    "actual_type": {
      "type": "string",
      "description": "Collection type Square actually saw: debit / credit (null for missing_payment)"
    },
    "status": {
      "type": "string",
      "description": "Discrepancy lifecycle: open, confirmed (owner applied the fix), dismissed (owner reviewed, no change), resolved (mismatch healed on its own)"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the owner confirmed the discrepancy fix"
    },
    "confirmed_by_name": {
      "type": "string",
      "description": "Display name of the owner who confirmed the fix"
    },
    "square_id": {
      "type": "string",
      "description": "Square payment id of the actual swipe (when known)"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Original delivery_date of the affected delivery (discrepancy rows) \u2014 used for the Date & Time display instead of the detection time"
    },
    "actual_delivery_time": {
      "type": "string",
      "description": "Original actual_delivery_time (ISO) of the affected delivery (discrepancy rows) \u2014 used for the Date & Time display"
    },
    "store_abbrev": {
      "type": "string",
      "description": "Store abbreviation for badge rendering (discrepancy rows)"
    },
    "store_color": {
      "type": "string",
      "description": "Store hex color for badge rendering (discrepancy rows)"
    }
  },
  "required": [
    "changed_at",
    "action",
    "detail"
  ]
}