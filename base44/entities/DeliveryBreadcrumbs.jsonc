{
  "name": "DeliveryBreadcrumbs",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "ID of the driver this breadcrumb leg belongs to"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Route date for these breadcrumbs (YYYY-MM-DD)"
    },
    "stop_order": {
      "type": "number",
      "description": "Stop order of the delivery this leg leads TO. NOTE (Oct 2 2026): stop_order is renumbered routinely (repairStopOrders after any stop edit/delete/create/optimization) and is NOT a stable key once a segment is sealed. linked_delivery_id is the authoritative match key when present; stop_order is kept in sync as a courtesy but must never be trusted alone once saved_to_route is true. Still used standalone for legacy records created before linked_delivery_id existed."
    },
    "linked_delivery_id": {
      "type": "string",
      "description": "The Delivery entity's own immutable .id this leg leads TO. Added Oct 2 2026 to fix sealed (saved_to_route=true) breadcrumb legs becoming orphaned or misattributed when stop_order gets renumbered after sealing — matching by stop_order alone let a renumber silently detach a saved path from its real stop (or attach it to the wrong one, or delete it as an 'orphan'). This is the PRIMARY match key for all slicing/reset code. Absent on legacy pre-migration records (those fall back to stop_order match)."
    },
    "encoded_polyline": {
      "type": "string",
      "description": "Polyline-encoded string of GPS coordinates for the actual path taken (Google/HERE flexible polyline format)"
    },
    "timestamps": {
      "type": "string",
      "description": "Comma-separated list of Unix timestamps in milliseconds, one per encoded coordinate point"
    },
    "transport_mode": {
      "type": "string",
      "enum": [
        "driving",
        "cycling",
        "pedestrian"
      ],
      "description": "Transport mode used for this leg"
    },
    "point_count": {
      "type": "number",
      "description": "Number of GPS points encoded in this record (for quick reference without decoding)"
    },
    "saved_to_route": {
      "type": "boolean",
      "default": false,
      "description": "True once this breadcrumb's cleaned polyline has been saved back to the Delivery route record"
    },
    "is_snapped": {
      "type": "boolean",
      "default": false,
      "description": "True when this master trail (stop_order = -1) has been road-snapped via snapMasterTimeline (HERE Route Matching). Used by consolidateBreadcrumbSegment to prefer the snapped master over stale raw duplicates created by the syncPendingBreadcrumbs race, and to clean up those duplicates."
    },
    "outage_timestamps": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Unix timestamps (ms) of force-committed breadcrumb points \u2014 fixes committed during a genuine GPS outage where no buffered fix was within the 250m chain-commit cap. Diagnostic only: lets the Route viewer / snap analysis annotate these as known GPS-outage gaps rather than sampling artifacts. snapMasterTimeline still fills the gaps via HERE routing. Stable across the timestamp-keyed merge in syncPendingBreadcrumbs."
    }
  },
  "required": [
    "driver_id",
    "delivery_date",
    "stop_order"
  ]
}
