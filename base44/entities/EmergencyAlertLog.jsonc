{
  "name": "EmergencyAlertLog",
  "type": "object",
  "properties": {
    "alert_id": { "type": "string", "description": "EmergencyAlert record id this log row follows (null while still unconfirmed)" },
    "driver_id": { "type": "string", "description": "Auth user id of the driver whose device raised or cancelled the alert" },
    "driver_name": { "type": "string" },
    "source": { "type": "string", "enum": ["manual", "crash"], "description": "manual = 5s map hold, crash = impact detection prompt" },
    "alert_type": { "type": "string", "enum": ["accident", "medical", "other"] },
    "status": {
      "type": "string",
      "enum": ["pending_confirmation", "sent", "cancelled", "resolved"],
      "description": "pending_confirmation = confirm screen open; sent = alert went out; cancelled = driver or dispatcher stood it down; resolved = handled after it was sent"
    },
    "outcome": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "resolved"] },
    "triggered_at": { "type": "string", "format": "date-time", "description": "The moment the hold completed / the impact prompt opened" },
    "confirmed_at": { "type": "string", "format": "date-time", "description": "The moment the alert was actually sent" },
    "cancelled_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": "string", "format": "date-time" },
    "seconds_to_decision": { "type": "number", "description": "Seconds from triggered_at to the send or cancel" },
    "countdown_seconds": { "type": "number", "description": "Auto-send countdown length that was running" },
    "auto_send_paused": { "type": "boolean", "description": "True when a touch paused the automatic send" },
    "cancellation_stage": { "type": "string", "enum": ["confirm_screen", "active_alert"], "description": "Where the cancel happened: the 10s confirmation screen, or standing down an alert that had already been sent" },
    "cancellation_reason": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "gps_accuracy": { "type": "number", "description": "Metres, as reported by the device" },
    "nearest_address": { "type": "string", "description": "Reverse-geocoded street address for the trigger point" },
    "address_status": { "type": "string", "enum": ["pending", "resolved", "unavailable"] },
    "map_url": { "type": "string" },
    "peak_force": { "type": "number", "description": "Peak acceleration magnitude (m/s²) for impact-sourced rows" },
    "sensitivity": { "type": "number", "description": "crash_threshold setting in force at the time, for tuning" },
    "device_identifier": { "type": "string" },
    "device_name": { "type": "string" },
    "recipient_user_ids": { "type": "array", "items": { "type": "string" } },
    "recipient_count": { "type": "number", "description": "Devices the push fan-out reported as sent" },
    "push_result": { "type": "string", "description": "Raw sendPushNotification summary for the alert or the cancellation" },
    "city_id": { "type": "string" },
    "store_ids": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "cancellation_notified": { "type": "boolean", "description": "True when stand-down pushes went out for the cancellation" },
    "client_session_id": { "type": "string", "description": "Device session that produced the row, for de-duplicating offline replays" }
  },
  "required": []
}
