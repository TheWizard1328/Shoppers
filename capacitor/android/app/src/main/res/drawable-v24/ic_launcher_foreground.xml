<?xml version="1.0" encoding="utf-8"?>
<!-- 
  RxDeliver launcher icon foreground.
  On API 26+ the adaptive icon (mipmap-anydpi-v26/ic_launcher.xml) references
  @mipmap/ic_launcher_foreground (a PNG generated from the RxDeliver brand
  icon). This vector is kept only as a fallback for API 24-25 devices.
  It renders the same green Rx badge on transparent background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <!-- Green circle (safe zone centered at 54,54, radius 24) -->
    <path
        android:fillColor="#22C55E"
        android:pathData="M54,30 C67.255,30 78,35.745 78,45 C78,54.255 67.255,60 54,60 C40.745,60 30,54.255 30,45 C30,35.745 40.745,30 54,30 Z" />

    <!-- White "R" letter -->
    <path
        android:fillColor="#FFFFFF"
        android:fillRule="evenOdd"
        android:pathData="M44,36 L48,36 L48,48 L44,48 Z M44,36 L52,36 C54,36 55,37 55,39 C55,41 54,42 52,42 L48,42 L48,40 L52,40 L52,38 L44,38 Z M48,42 L51,42 L55,48 L52,48 Z" />

    <!-- White "x" letter -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M58,40 L60,38 L62,40 L60,42 Z M60,38 L62,40 L64,38 L62,36 Z" />

</vector>
