<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified Android App Link for the NATIVE-ONLY OAuth callback path.
                 OWNER BUG (Oct 25 2026): this filter matched /oauth-callback — the
                 path the WEB/PWA Google login lands on — so on any phone with the
                 APK installed, Android's verified App Link capture hijacked the
                 BROWSER login (assetlinks.json on the domain lists
                 com.rxdeliver.driver with the matching signing cert): Chrome
                 redirected to the APK, the browser origin never received the
                 token, and the web app re-booted in a loop. The native login sends
                 from_url=/native-oauth-callback (Login.jsx OAUTH_REDIRECT), so the
                 filter now captures ONLY that path — APK logins still open the app
                 directly (no browser, no chooser, fixing "stays in the browser
                 after login"), and web logins stay in the browser where the token
                 completes the session. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="rxdeliver.wizardworxx.com"
                    android:pathPrefix="/native-oauth-callback" />
            </intent-filter>

            <!-- Custom-scheme deep link fallback: rxdeliver://auth?access_token=...
                 Kept for redundancy in case App Link verification hasn't completed
                 yet on a given device (e.g. right after a fresh install). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rxdeliver" android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Background Geolocation foreground service is auto-registered by the
             @capgo/background-geolocation plugin's own AndroidManifest at build time.
             Do NOT manually declare it here — a stale reference to the uninstalled
             @capacitor-community package causes a class-not-found at runtime. -->

    </application>

    <!-- ==================== Permissions ==================== -->

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location (always-on GPS via foreground service) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Bluetooth (Inkbird BLE auto-connect + background scanning) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Camera (barcode scanning, prescription label scanning, proof of delivery) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone (Hey Doc voice assistant — wake-word listening + commands) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Wake lock (keep CPU alive for GPS + BLE during screen off) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Proximity auto-foreground (isNextDelivery approach trigger) -->
    <!-- Full-screen intent notification: launches the app over the lock screen
         when the driver approaches their next stop with the screen off. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "Display over other apps" — grants the official Background Activity
         Launch exemption so the app can truly bring itself to the front while
         backgrounded (screen ON case). Users grant this manually via the
         system settings page (requestOverlayPermission bridge opens it). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- APK self-update: DownloadManager handles the .apk download (shows the
         native "Download complete" notification), then the install intent
         needs this permission to prompt the install screen on tap. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ==================== Feature Declarations (optional) ==================== -->
    <!-- Declare GPS + BLE as not required so the app installs on devices without them -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

</manifest>
